    "4": { "name": "books", "type": "query", "cacheable": true, "description": "Bookstore catalog with field bitmask projection" },
    "5": { "name": "create_book", "type": "mutate", "cacheable": false, "description": "Append book entry to catalog" },
    "10": { "name": "getUser", "type": "query", "cacheable": true, "description": "User security profile lookup" }
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8080
  }
}
