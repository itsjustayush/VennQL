{
  "name": "VennQL Canonical Reference API",
  "version": "0.1.0",
  "protocol": {
    "version": 1,
    "magic": "0x56",
    "wire": "binary",
    "transport": ["websocket", "webtransport"],
    "max_payload_size_mb": 16
  },
  "procedures": {
    "1": { "name": "health", "type": "query", "cacheable": true, "description": "Liveness and system health status probe" },
